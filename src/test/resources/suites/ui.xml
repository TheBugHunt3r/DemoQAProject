<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="UI Regression Suite">
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="core.utils.TestListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="tests.ui.LoginTest"/>
            <class name="tests.ui.BookStoreTest"/>
        </classes>
    </test>
</suite>