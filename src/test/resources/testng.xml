<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="CI Server Suite">

    <listeners>
        <listener class-name="utils.SuiteListener"/>
        <listener class-name="utils.RetryListener"/>
        <listener class-name="utils.TestListener"/>
    </listeners>

    <parameter name="xmlBrowser" value="chrome"/>

    <suite-files>
        <suite-file path="ui.xml"/>
        <suite-file path="api.xml"/>
    </suite-files>
</suite>